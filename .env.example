# Supabase (cloud Postgres for AgentCore) — fill from dashboard
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# Postgres: direct host is often IPv6-only (fine locally). AgentCore MCP needs IPv4 Session pooler
# from Dashboard → Connect (host may be aws-0/1/2-<region> — region can differ from AWS_REGION).
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Required for AgentCore MCP when direct is IPv6-only:
# DATABASE_URL_POOLER=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_POOLER_REGION.pooler.supabase.com:5432/postgres?sslmode=require

AWS_REGION=ap-south-1
MODEL_ID=apac.anthropic.claude-3-haiku-20240307-v1:0
GATEWAY_CONFIG_PATH=src/gateway/setup/gateway_config.json
CSV_PATH=data/raw_tickets.csv
